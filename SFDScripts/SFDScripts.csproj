<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SFDScripts</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Generator>$(MSBuildThisFileDirectory)..\tools\SFD.ScriptTools.ScriptGenerator.fsx</Generator>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RequiredGameSdkVersion>1.0.0+931860ddfb9ec5710696655123edd7732ada60c2</RequiredGameSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SFD.GameScriptInterface">
      <HintPath>..\lib\SFD.GameScriptInterface.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="GenerateScript" DependsOnTargets="Build">
    <ItemGroup>
      <ScriptFile Include="$(ScriptFiles)" />
    </ItemGroup>
    <Error Condition="'@(ScriptFile)' == '' Or '$(ScriptOutput)' == ''" Text="Pass -p:ScriptFiles=&quot;file1.cs;file2.cs&quot; -p:ScriptOutput=path.txt" />
    <Exec Command="dotnet fsi &quot;$(Generator)&quot; @(ScriptFile->'&quot;%(FullPath)&quot;', ' ') -o &quot;$(ScriptOutput)&quot;" />
  </Target>

  <Target Name="GenerateHardcoreScript" DependsOnTargets="Build">
    <ItemGroup>
      <HardcoreSource Include="Internal\Hardcore\Source\**\*.cs" />
    </ItemGroup>
    <Exec Command="dotnet fsi &quot;$(Generator)&quot; @(HardcoreSource->'&quot;%(FullPath)&quot;', ' ') -o &quot;$(OutputPath)Hardcore.txt&quot;" />
  </Target>

  <ItemGroup>
    <None Include="App.config" />
    <None Include="Internal\Hardcore\Maps\*.sfdm" />
    <None Include="Internal\Hardcore\Source\Extra\*.txt" />
    <None Include="LICENSE" />
  </ItemGroup>
</Project>
